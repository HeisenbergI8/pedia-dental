{
  "name": "@pedia/infra",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "echo 'no lint in infra'",
    "tf:fmt": "terraform -chdir=terraform fmt -check -recursive",
    "tf:validate": "terraform -chdir=terraform init -backend=false -input=false && terraform -chdir=terraform validate"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "yaml": "^2"
  }
}
