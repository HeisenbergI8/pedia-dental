{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node --import @swc-node/register/esm-register src/main.ts",
    "build": "node build.mjs dist",
    "start:prod": "node --enable-source-maps dist/main.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "prisma db seed",
    "db:demo-reset": "node --import @swc-node/register/esm-register prisma/demo-reset.ts",
    "db:backfill-due-items": "node --import @swc-node/register/esm-register prisma/backfill-due-items.ts",
    "db:backfill-standing": "node --import @swc-node/register/esm-register prisma/backfill-standing.ts",
    "db:clinic-export": "node --import @swc-node/register/esm-register prisma/clinic-data.ts export",
    "db:clinic-purge": "node --import @swc-node/register/esm-register prisma/clinic-data.ts purge",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "lint": "echo 'no lint in api'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts",
    "load:seed": "node --import @swc-node/register/esm-register prisma/load-seed.ts",
    "load:run": "node --import @swc-node/register/esm-register test/load/run.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^12",
    "@types/autocannon": "^7.12.7",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5",
    "@types/jsdom": "28.0.3",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "esbuild": "^0.25",
    "supertest": "^7.3.1",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@nestjs/common": "^12",
    "@nestjs/core": "^12",
    "@nestjs/platform-express": "^12",
    "@nestjs/schedule": "^12.0.2",
    "@node-rs/argon2": "^2.0.2",
    "@pedia/seed": "workspace:^",
    "@pedia/shared": "workspace:^",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.18",
    "busboy": "^1.6.0",
    "date-fns": "^4.4.0",
    "dompurify": "3.4.16",
    "helmet": "^8",
    "jsdom": "29.1.1",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  }
}
