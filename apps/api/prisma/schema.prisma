// Models arrive feature by feature, mirroring the MSW handlers in apps/web/src/features/*/mocks.ts.
// The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

/// Mirrors Role in packages/shared/src/schemas/common.ts (tenant-scope.test.ts checks they match).
enum Role {
  owner
  admin
  dentist
  front_desk
  parent
}

/// Mirrors AuditAction in packages/shared/src/schemas/audit.ts (tenant-scope.test.ts checks they match).
enum AuditAction {
  sign_in
  sign_in_failed
  sign_out
  timed_out
  view
  create
  update
  export
  denied
}

/// Who touched which personal data, and when (RA 10173). Append-only: APPEND_ONLY in src/prisma/model-scope.ts.
/// The actor's name and role are copied in so the entry still says who it was after the account changes.
model AuditEvent {
  id        String      @id @default(cuid(2))
  clinicId  String
  at        DateTime
  actorId   String
  actorName String
  actorRole Role
  action    AuditAction
  /// What was touched, in clinic words: "Dental chart", "Patient list".
  record    String
  patientId String?

  @@index([clinicId, at])
  @@index([clinicId, actorId, at])
  @@index([clinicId, patientId, at])
}

/// Mirrors StaffRole in packages/shared/src/schemas/common.ts (tenant-scope.test.ts checks they match).
enum StaffRole {
  admin
  dentist
  front_desk
}

/// Mirrors Tier in packages/shared/src/schemas/tenancy.ts.
enum Tier {
  small
  mid
  big
}

/// Mirrors AccountStatus in packages/shared/src/schemas/tenancy.ts.
enum AccountStatus {
  active
  suspended
}

/// Mirrors HeadingFont in packages/shared/src/schemas/tenancy.ts.
enum HeadingFont {
  nunito
  poppins
  lexend
  quicksand
  outfit
  fredoka
}

/// Mirrors AgreementRecord.method in packages/shared/src/schemas/legal.ts.
enum AgreementMethod {
  online
  on_file
}

/// Mirrors Acknowledgement.kind in packages/shared/src/schemas/legal.ts (terms acceptances are Agreements).
enum AcknowledgedKind {
  confidentiality
  notice
}

/// One paying clinic: the tenant itself. Platform: the operator lists them all, and its id is every tenant row's clinicId.
model ClinicAccount {
  id           String        @id @default(cuid(2))
  name         String
  logoRef      String?
  contactEmail String
  tin          String
  tier         Tier
  status       AccountStatus
  /// #rrggbb. Tints and the dark version are derived (deriveBrandPalette), never stored.
  brandColor   String        @db.Char(7)
  headingFont  HeadingFont?
}

/// One location of a clinic account. Archived, never deleted (decision #22).
model Branch {
  id           String  @id @default(cuid(2))
  clinicId     String
  name         String
  address      String
  phone        String
  /// OpeningHours (@pedia/shared), parsed with that schema on read. Json: never filtered on.
  openingHours Json
  archived     Boolean @default(false)
  /// List order, as the clinic set them up (the mock's array order). New branches go last (B3).
  position     Int     @default(0)

  @@index([clinicId, archived])
}

/// A clinic's staff member (StaffMember in @pedia/shared). Deactivated, never deleted (decision #23).
model Staff {
  id            String    @id @default(cuid(2))
  clinicId      String
  fullName      String
  role          StaffRole
  /// StaffRole[]: a second staff role held too (decision #39). Json: read whole, never filtered on.
  alsoRoles     Json
  isOwner       Boolean   @default(false)
  /// Branch ids where they work (decision #14). Json: matched in code by usableBranches.
  branchIds     Json
  licenseNo     String?
  /// The sign-in email: typed by the Owner, or derived by the seed (staffEmail in @pedia/seed).
  email         String
  deactivatedAt DateTime?
  /// List order, as the clinic added them (the mock's array order). New staff go last (B3).
  position      Int       @default(0)

  /// One login per email per account, deactivated logins included (decision #27). StaffService also checks it, with
  /// parents' emails, under the clinic's lock (B3, Decision 4); this is the backstop.
  @@unique([clinicId, email])
}

/// One login's secrets, staff or guardian, in one clinic account. Never served.
/// Platform: sign-in finds it by email across clinic accounts before one is chosen (decision #27). Every query names
/// clinicId itself. Only IdentityService, SessionService and the seed read it.
model Credential {
  id           String  @id @default(cuid(2))
  clinicId     String
  /// The login as sessions and the audit trail name it: the staff id, or `guardian.<guardianId>` (as the mock).
  accountId    String
  email        String
  staffId      String?
  guardianId   String?
  /// A guardian's name until B4 brings guardians. A staff login's name is read from Staff.
  name         String
  passwordHash String
  /// A login the Owner just made: must choose its own password first (decision #21).
  mustChange   Boolean @default(false)
  /// Staff only. The PIN for switching user on a shared device (decision #24).
  pinHash      String?
  /// ISO times of recent wrong PINs inside PIN_POLICY's window (pinAttempt keeps only those).
  pinFailedAt  Json

  @@unique([clinicId, accountId])
  @@index([email])
}

/// A signed-in clinic login. Platform: the guard finds it by the cookie's token hash before it knows the clinic.
/// Deleted on sign-out or expiry (not append-only: sign-ins are recorded in AuditEvent).
model Session {
  id         String   @id @default(cuid(2))
  /// SHA-256 of the pd_session token, hex. The token itself is never stored.
  tokenHash  String   @unique @db.Char(64)
  clinicId   String
  accountId  String
  createdAt  DateTime
  /// Moved forward at most once a minute (SessionService.TOUCH_EVERY_MS). Idle expiry reads it.
  lastSeenAt DateTime
  /// createdAt + 8 h: the absolute limit, however active the session is.
  expiresAt  DateTime

  @@index([clinicId, accountId])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

/// Primolar's own staff (decisions #3, #25). Never a clinic user: no clinicId, no role.
model OperatorUser {
  id           String @id @default(cuid(2))
  name         String
  email        String @unique
  passwordHash String
}

/// A signed-in operator, on its own cookie (pd_operator) and its own table, so it can't be mistaken for a clinic
/// session, or the reverse.
model OperatorSession {
  id         String   @id @default(cuid(2))
  tokenHash  String   @unique @db.Char(64)
  operatorId String
  createdAt  DateTime
  lastSeenAt DateTime
  expiresAt  DateTime

  @@index([operatorId])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

/// A clinic's acceptance of Primolar's Terms and DPA (ClinicAgreement). Append-only; the newest per clinic is in
/// force. Platform: Primolar's record (root CONVENTIONS: agreements are never inside a tenant).
model Agreement {
  id           String          @id @default(cuid(2))
  clinicId     String
  termsVersion Int
  dpaVersion   Int
  acceptedBy   String
  at           DateTime
  method       AgreementMethod
  /// The date a paper copy was signed (on_file only), Asia/Manila.
  signedOn     DateTime?       @db.Date

  @@index([clinicId, at])
}

/// One login's reading of a confidentiality or notice version (privacy #20, #21). Append-only.
model Acknowledgement {
  id        String           @id @default(cuid(2))
  clinicId  String
  kind      AcknowledgedKind
  version   Int
  accountId String
  name      String
  at        DateTime

  @@index([clinicId, accountId, kind, version])
}

/// One saved version of a clinic's privacy notice (privacy #19). Append-only; the highest version is in force.
model PrivacyNotice {
  id           String   @id @default(cuid(2))
  clinicId     String
  version      Int
  body         String   @db.Text
  contactName  String
  contactEmail String
  savedByName  String
  at           DateTime

  @@unique([clinicId, version])
}

/// A treatment chair (Chair in @pedia/shared). Belongs to one branch, but MODEL_SCOPE is "clinic": GET /chairs is
/// account-wide, so a chair in a child's history resolves whichever branch the device is on (B3, Decision 8).
model Chair {
  id       String @id @default(cuid(2))
  clinicId String
  branchId String
  name     String
  /// List order (the mock's array order). New chairs go last.
  position Int    @default(0)

  @@index([clinicId, branchId])
}

/// One billable procedure (Procedure in @pedia/shared). `code` is the contract's key: note templates, plan items and
/// follow-up rules name it, so it is the primary key with the clinic (B3, Decision 7).
model Procedure {
  clinicId           String
  code               String  @db.VarChar(64)
  name               String
  defaultDurationMin Int
  /// Centavos (CONVENTIONS → Data: money is Int).
  fee                Int
  /// The fee is charged per tooth treated.
  perTooth           Boolean
  position           Int     @default(0)

  @@id([clinicId, code])
}

/// A clinical note's form (NoteTemplate in @pedia/shared). Ids (`tpl_oral_exam`) repeat in every clinic, so the
/// primary key is (clinicId, id). `fields` is TemplateField[], parsed with that schema on read; never filtered on.
model NoteTemplate {
  clinicId  String
  id        String  @db.VarChar(64)
  name      String
  /// A Procedure.code.
  procedure String  @db.VarChar(64)
  fields    Json
  position  Int     @default(0)

  @@id([clinicId, id])
}

/// Mirrors MessageKind in packages/shared/src/schemas/message.ts (tenant-scope.test.ts checks they match).
enum MessageKind {
  appointment_confirmation
  appointment_reminder
  post_extraction
  post_pulpotomy
  fluoride_instructions
  pre_treatment
  missed_appointment
  follow_up_reminder
  recall
  birthday
}

/// A parent message's wording (MessageTemplate in @pedia/shared): one per kind per clinic, edited on the Messages page.
model MessageTemplate {
  clinicId  String
  kind      MessageKind
  name      String
  /// At most 480 characters (TemplateBody), placeholders checked by the shared schema.
  body      String      @db.VarChar(480)
  updatedAt DateTime
  position  Int         @default(0)

  @@id([clinicId, kind])
}

/// Demo deployments only (DEMO_LOGINS=true): the sign-in page's one-click accounts, with the PIN shown in the clear,
/// because PINs are otherwise stored only as hashes. Written only by the seed. Platform: served before sign-in.
model DemoLogin {
  id        String  @id @default(cuid(2))
  clinicId  String
  accountId String
  role      Role
  name      String
  email     String
  summary   String
  pin       String? @db.Char(4)
  /// Order on the login screen (demoAccounts' order).
  position  Int
  /// One of the per-role logins listed on the sign-in page (demoLogins in @pedia/seed).
  featured  Boolean @default(false)

  @@index([clinicId, position])
}

/// Fixed-window request counters for the auth routes (CONVENTIONS → Stateless instances: rate-limit counters live in
/// MySQL, so every instance shares them). Platform: counted before anyone is signed in. Written only by
/// RateLimitService, with raw SQL (INSERT … ON DUPLICATE KEY UPDATE). Old windows are swept by B1-c's scheduler.
model RateLimitCounter {
  /// `<group>:<client ip>`, e.g. `login:203.0.113.7` (rate-limit.ts → bucketOf).
  bucket      String   @db.VarChar(191)
  windowStart DateTime
  hits        Int

  @@id([bucket, windowStart])
  @@index([windowStart])
}

/// Where a row stands. `pending` covers both "waiting" and "leased": a lease is `availableAt` moved forward (B1-c plan).
enum OutboxStatus {
  pending
  done
  failed
}

/// Side effects leaving the system (SMS, email, webhooks), written in the same transaction as the change that caused
/// them and sent by OutboxWorker (CONVENTIONS → Side effects). Platform: the worker reads across clinics; each
/// handler runs inside the row's clinic. Written only by OutboxService and OutboxWorker.
model OutboxMessage {
  id          String       @id @default(cuid(2))
  /// The clinic the side effect belongs to; null for platform mail (sign-ups, B12).
  clinicId    String?
  /// Which OutboxHandler runs it ("noop"; B9 adds message kinds).
  kind        String       @db.VarChar(64)
  /// Ids and flags only, never patient data: the handler loads what it sends.
  payload     Json
  status      OutboxStatus @default(pending)
  /// Not before this moment: a scheduled send (B9's reminders), a retry's backoff, or a running lease.
  availableAt DateTime
  /// Claims so far. A settle only counts if it still matches its claim's number.
  attempts    Int          @default(0)
  /// The error's name and Prisma code only. Messages can quote personal data.
  lastError   String?      @db.VarChar(191)
  createdAt   DateTime
  processedAt DateTime?

  @@index([status, availableAt])
  @@index([status, processedAt])
}

/// One row per scheduled job: a lease that one API instance holds per run (JobRunner). Platform.
model JobLock {
  name           String    @id @db.VarChar(64)
  lockedUntil    DateTime
  /// `<host>:<pid>:<random>` of the holder, for diagnosis only.
  lockedBy       String    @db.VarChar(191)
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
}

/// Mirrors Sex in packages/shared/src/schemas/patient.ts (tenant-scope.test.ts checks they match).
enum Sex {
  male
  female
}

/// Mirrors ConsentScope in packages/shared/src/schemas/patient.ts (tenant-scope.test.ts checks they match).
enum ConsentScope {
  general_treatment
  local_anesthesia
  extraction
  radiographs
  clinical_photos
  sedation
}

/// Mirrors PrivacyChoice.by in packages/shared/src/schemas/legal.ts (tenant-scope.test.ts checks they match).
enum PrivacyChoiceBy {
  staff
  parent
}

/// A child's record (Patient in @pedia/shared). Responses are built only by visibleTo (src/patients/patient.views.ts),
/// which leaves the address, the emergency contact and guardian phones and emails out without patients.contact.
/// Never deleted. Seeded ids (UUIDs) are kept, so MSW's visits and invoices in `hybrid` still point at them.
model Patient {
  id                String    @id @default(cuid(2))
  clinicId          String
  /// KS-00042: the clinic's chart number, assigned under the clinic's lock (nextPatientNo). Never reused.
  patientNo         String    @db.VarChar(16)
  firstName         String
  lastName          String
  nickname          String?   @db.VarChar(30)
  birthDate         DateTime  @db.Date
  sex               Sex
  address           String?   @db.Text
  emergencyName     String?
  emergencyPhone    String?
  /// string[] each: read whole, parsed with the shared schema, never filtered on.
  allergies         Json
  noKnownAllergies  Boolean?
  medicalConditions Json
  medications       Json
  noKnownConditions Boolean?
  alerts            Json
  /// PatientTag[] or null (the contract's `tags` is optional: absent is not []).
  tags              Json?
  /// { previousClinic, notes }.
  dentalHistory     Json
  /// PatientProfile or null.
  profile           Json?
  /// The storage key of the child's photo (StorageService), or null. Set only by the photo routes.
  photoRef          String?
  photoUpdatedAt    DateTime?
  createdAt         DateTime
  /// Decision 1: lowercased child and guardian names (patientSearchText), matched with LIKE per word. Never served.
  searchNames       String    @db.Text
  /// Decision 1: every guardian phone, digits only. Matched only for callers holding patients.contact. Never served.
  searchPhones      String    @db.VarChar(512)

  @@unique([clinicId, patientNo])
  /// The list's order (lastName, firstName, id) and name lookups.
  @@index([clinicId, lastName, firstName])
  /// Duplicate detection: same birth date first, then the names compared in code (findDuplicates).
  @@index([clinicId, birthDate])
}

/// One guardian of one child (Guardian in @pedia/shared). Siblings carry the same guardianId, each in their own row:
/// a PUT replaces only that child's rows (as the mock), and PATCH's phone follows the guardianId to every child.
model PatientGuardian {
  clinicId     String
  patientId    String
  /// The contract's Guardian.id, chosen by the web (and the seed). A parent login is `guardian.<guardianId>`.
  guardianId   String  @db.VarChar(64)
  fullName     String
  relationship String
  phone        String  @db.VarChar(32)
  email        String?
  isPrimary    Boolean
  /// The guardians' order on the record (the mock's array order).
  position     Int     @default(0)

  @@id([clinicId, patientId, guardianId])
  /// A parent's children (decision 5), and PATCH's phone following the guardian.
  @@index([clinicId, guardianId])
  /// Siblings: children sharing a guardian phone (siblingsOf).
  @@index([clinicId, phone])
}

/// A treatment consent (ConsentRecord in @pedia/shared). Append-only: APPEND_ONLY in src/prisma/model-scope.ts.
model PatientConsent {
  id         String       @id @default(cuid(2))
  clinicId   String
  patientId  String
  guardianId String       @db.VarChar(64)
  scope      ConsentScope
  date       DateTime     @db.Date
  createdAt  DateTime

  @@index([clinicId, patientId, createdAt])
}

/// The parent's required privacy consent (PrivacyConsent in @pedia/shared, privacy #12, #16, #17). Recorded once per
/// child: the key refuses a second. Append-only. The guardian's name and relationship are copied as they were then (#23).
model PatientPrivacyConsent {
  clinicId       String
  patientId      String
  guardianId     String   @db.VarChar(64)
  guardianName   String
  relationship   String
  noticeVersion  Int
  formVersion    Int
  recordedById   String
  recordedByName String
  at             DateTime

  @@id([clinicId, patientId])
}

/// One state of the optional consents (PrivacyChoice in @pedia/shared, privacy #13–#15). Append-only; the highest
/// position is in force (currentChoices).
model PrivacyChoice {
  id        String          @id @default(cuid(2))
  clinicId  String
  patientId String
  position  Int
  photos    Boolean
  reminders Boolean
  by        PrivacyChoiceBy
  byName    String
  at        DateTime

  @@unique([clinicId, patientId, position])
}

/// Mirrors VisitStatus in packages/shared/src/schemas/visit.ts (tenant-scope.test.ts checks they match).
enum VisitStatus {
  in_progress
  completed
}

/// One sitting in the chair (Visit in @pedia/shared). Chart entries, and from B6 notes and growth, attach to it. At most
/// one in progress per patient: every write locks the patient's row first (lockPatient). The only update is completing.
/// Seeded ids (UUIDs, `visit_roster_<n>`) are kept, so MSW's notes and plan items in `hybrid` still point at them.
model Visit {
  id            String      @id @default(cuid(2))
  clinicId      String
  patientId     String
  dentistId     String
  /// Stored as given until B7 brings appointments (decision 1): nothing checks or seats it yet.
  appointmentId String?
  /// The clinic's calendar day it started on (Clock.today(), Asia/Manila).
  date          DateTime    @db.Date
  status        VisitStatus
  startedAt     DateTime
  completedAt   DateTime?

  /// The visit list, newest first, and the one in progress.
  @@index([clinicId, patientId, startedAt])
  /// The last visit's day per patient (VisitDaysService): completed only, MAX(date).
  @@index([clinicId, patientId, status, date])
}

/// Mirrors ToothCondition in packages/shared/src/schemas/chart.ts (tenant-scope.test.ts checks they match).
enum ToothCondition {
  sound
  caries
  restored
  sealant
  fluoride
  pulpotomy
  pulpectomy
  extracted
  missing
  unerupted
  erupting
}

/// One finding on one tooth (ChartEntry in @pedia/shared). Append-only: APPEND_ONLY in src/prisma/model-scope.ts refuses
/// every update and delete. A correction is a new row naming the one it replaces in `supersedes`. The chart is
/// deriveChart() over these rows, in the web and in the tests, never stored.
model ChartEntry {
  id         String         @id @default(cuid(2))
  clinicId   String
  patientId  String
  visitId    String
  /// FDI number (ALL_TEETH), checked by the shared schema.
  tooth      Int
  /// Surface[] in the order given; [] is the whole tooth. Read whole, never filtered on.
  surfaces   Json
  condition  ToothCondition
  note       String?        @db.Text
  /// The visit's dentist (the mock's rule), not the caller.
  recordedBy String
  recordedAt DateTime
  supersedes String?

  /// An entry is corrected once (the mock's 409). The service checks it under the patient's lock; this is the backstop.
  /// MySQL allows many NULLs in a unique index, so uncorrected entries don't collide.
  @@unique([clinicId, supersedes])
  /// A patient's whole history, oldest first: GET /patients/:id/chart and every write's deriveChart (CHUNKS B5).
  @@index([clinicId, patientId, recordedAt])
}

/// The plan item's state. `done` only by signing a matching note (itemsCompletedBy); progress is never stored.
enum PlanItemStatus {
  planned
  in_progress
  done
  declined
}

/// B6: a clinical note from a template (features/notes/mocks.ts). A draft is edited in place; a signed note is
/// read-only, enforced in NotesService (every change is an update guarded by `signedAt IS NULL`, decision 6).
model ClinicalNote {
  id           String    @id @default(cuid(2))
  clinicId     String
  patientId    String
  visitId      String
  /// A NoteTemplate.id of this clinic.
  templateId   String    @db.VarChar(64)
  /// The values noteValuesSchema(template) returned: checked, unknown keys dropped. Read whole, never filtered on.
  values       Json
  /// BehaviorRating[] in the order given (behaviour tracking, feature 9).
  behavior     Json
  /// Absent is null; "" is kept as given, as the mock. BEHAVIOR_NOTE_MAX (300) characters on input.
  behaviorNote String?   @db.VarChar(300)
  /// The visit's dentist (the mock's rule), not the caller.
  authorId     String
  createdAt    DateTime
  signedAt     DateTime?

  /// GET /patients/:id/notes, newest first.
  @@index([clinicId, patientId, createdAt])
}

/// B6: growth and development as observed at one visit (features/growth/mocks.ts). Re-saving replaces it.
model GrowthRecord {
  id         String   @id @default(cuid(2))
  clinicId   String
  patientId  String
  visitId    String
  /// HabitObservation[]: the ticked habits, in the order given.
  habits     Json
  speech     String?  @db.Text
  /// When it was last saved: a re-save moves it, as the mock's.
  recordedAt DateTime

  /// One record per visit. GrowthService replaces it under the patient's lock; this is the backstop.
  @@unique([clinicId, visitId])
  /// GET /patients/:id/growth, oldest first.
  @@index([clinicId, patientId, recordedAt])
}

/// B6: one planned treatment (features/plan/mocks.ts). Status changes in place; `done` only through a signed note.
model PlanItem {
  id                 String         @id @default(cuid(2))
  clinicId           String
  patientId          String
  /// A Procedure.code of this clinic.
  procedureCode      String         @db.VarChar(64)
  /// FDI number, checked by the shared schema. Null: the item isn't per tooth.
  tooth              Int?
  /// Centavos (CONVENTIONS → Data: money is Int).
  fee                Int
  status             PlanItemStatus
  /// Stored as given, as the mock (decision 4).
  sourceChartEntryId String?
  completedVisitId   String?
  completedNoteId    String?
  createdAt          DateTime

  /// GET /patients/:id/plan, oldest first, and sign's lookup of a patient's open items.
  @@index([clinicId, patientId, createdAt])
}

enum AppointmentStatus {
  booked
  confirmed
  arrived
  in_chair
  done
  no_show
  cancelled
}

/// features/appointments/mocks.ts. Branch-owned in the contract, read account-wide (conflicts across branches, a child's
/// appointments, branch=all reports), so "clinic" in MODEL_SCOPE with branchId as a plain column (E5). Every read and
/// write goes through AppointmentRecordsService (E4).
model Appointment {
  id            String            @id @default(cuid(2))
  clinicId      String
  branchId      String
  patientId     String
  dentistId     String
  chairId       String
  startsAt      DateTime
  durationMin   Int
  reason        String            @db.Text
  procedureCode String?           @db.VarChar(64)
  status        AppointmentStatus
  cancelReason  String?           @db.Text
  sourceRuleId  String?           @db.VarChar(64)

  @@index([clinicId, branchId, startsAt])
  @@index([clinicId, chairId, startsAt])
  @@index([clinicId, dentistId, startsAt])
  @@index([clinicId, patientId, startsAt])
}

enum TimeOfDay {
  morning
  afternoon
  any
}

enum AppointmentRequestStatus {
  pending
  handled
}

/// A parent's request from the portal (appointments/mocks.ts:137–183). Not an appointment: staff book it.
model AppointmentRequest {
  id            String                   @id @default(cuid(2))
  clinicId      String
  patientId     String
  guardianId    String
  preferredDate DateTime                 @db.Date
  timeOfDay     TimeOfDay
  reason        String                   @db.VarChar(200)
  note          String?                  @db.VarChar(500)
  status        AppointmentRequestStatus
  createdAt     DateTime

  @@index([clinicId, status, createdAt])
  @@index([clinicId, patientId, createdAt])
}

enum DueKind {
  follow_up
  recall
}

/// A follow-up or recall a signed note made due (dueItemFor). Open is computed (isDueItemOpen), never stored.
model DueItem {
  id            String    @id @default(cuid(2))
  clinicId      String
  patientId     String
  ruleId        String    @db.VarChar(64)
  kind          DueKind
  procedure     String    @db.VarChar(64)
  dueOn         DateTime  @db.Date
  sourceNoteId  String
  visitId       String
  appointmentId String?
  closedAt      DateTime?
  createdAt     DateTime

  @@unique([clinicId, sourceNoteId])
  @@index([clinicId, closedAt, dueOn])
  @@index([clinicId, patientId, procedure])
}
