// Models arrive feature by feature, mirroring the MSW handlers in apps/web/src/features/*/mocks.ts.
// The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

/// Mirrors Role in packages/shared/src/schemas/common.ts (tenant-scope.test.ts checks they match).
enum Role {
  owner
  admin
  dentist
  front_desk
  parent
}

/// Mirrors AuditAction in packages/shared/src/schemas/audit.ts (tenant-scope.test.ts checks they match).
enum AuditAction {
  sign_in
  sign_in_failed
  sign_out
  timed_out
  view
  create
  update
  export
  denied
}

/// Who touched which personal data, and when (RA 10173). Append-only: APPEND_ONLY in src/prisma/model-scope.ts.
/// The actor's name and role are copied in so the entry still says who it was after the account changes.
model AuditEvent {
  id        String      @id @default(cuid(2))
  clinicId  String
  at        DateTime
  actorId   String
  actorName String
  actorRole Role
  action    AuditAction
  /// What was touched, in clinic words: "Dental chart", "Patient list".
  record    String
  patientId String?

  @@index([clinicId, at])
  @@index([clinicId, actorId, at])
  @@index([clinicId, patientId, at])
}

/// B13a (F1): what the Primolar operator did in the console. Platform-scoped, append-only (model-scope.ts). Never a
/// patient field: the operator never reads one.
model OperatorAuditEvent {
  id           String      @id @default(cuid(2))
  at           DateTime
  /// The operator; the sign-in's operator for sign_in_failed (a wrong password for a known email).
  operatorId   String
  operatorName String
  action       AuditAction
  /// What was touched, in console words: "Clinic account", "Sign-up", "Price list".
  record       String
  /// What happened, in console words: "Account paused".
  detail       String      @db.VarChar(191)
  /// The route's :id (a clinic account, sign-up or receipt), or the created clinic's id. Null for the price list,
  /// the QR and sign-in events.
  targetId     String?

  @@index([at])
  @@index([targetId, at])
  @@index([operatorId, at])
}

/// Mirrors StaffRole in packages/shared/src/schemas/common.ts (tenant-scope.test.ts checks they match).
enum StaffRole {
  admin
  dentist
  front_desk
}

/// Mirrors Tier in packages/shared/src/schemas/tenancy.ts.
enum Tier {
  small
  mid
  big
}

/// Mirrors AccountStatus in packages/shared/src/schemas/tenancy.ts.
enum AccountStatus {
  active
  suspended
}

/// Mirrors HeadingFont in packages/shared/src/schemas/tenancy.ts.
enum HeadingFont {
  nunito
  poppins
  lexend
  quicksand
  outfit
  fredoka
}

/// Mirrors AgreementRecord.method in packages/shared/src/schemas/legal.ts.
enum AgreementMethod {
  online
  on_file
}

/// Mirrors Acknowledgement.kind in packages/shared/src/schemas/legal.ts (terms acceptances are Agreements).
enum AcknowledgedKind {
  confidentiality
  notice
}

/// One paying clinic: the tenant itself. Platform: the operator lists them all, and its id is every tenant row's clinicId.
model ClinicAccount {
  id           String        @id @default(cuid(2))
  name         String
  logoRef      String?
  contactEmail String
  tin          String
  tier         Tier
  status       AccountStatus
  /// #rrggbb. Tints and the dark version are derived (deriveBrandPalette), never stored.
  brandColor   String        @db.Char(7)
  headingFont  HeadingFont?
  /// B13c2b-2 (D13): when db:clinic-purge finished deleting this clinic's data. The row and Primolar's books stay.
  purgedAt     DateTime?
}

/// One location of a clinic account. Archived, never deleted (decision #22).
model Branch {
  id           String  @id @default(cuid(2))
  clinicId     String
  name         String
  address      String
  phone        String
  /// OpeningHours (@pedia/shared), parsed with that schema on read. Json: never filtered on.
  openingHours Json
  archived     Boolean @default(false)
  /// List order, as the clinic set them up (the mock's array order). New branches go last (B3).
  position     Int     @default(0)

  @@index([clinicId, archived])
}

/// A clinic's staff member (StaffMember in @pedia/shared). Deactivated, never deleted (decision #23).
model Staff {
  id            String    @id @default(cuid(2))
  clinicId      String
  fullName      String
  role          StaffRole
  /// StaffRole[]: a second staff role held too (decision #39). Json: read whole, never filtered on.
  alsoRoles     Json
  isOwner       Boolean   @default(false)
  /// Branch ids where they work (decision #14). Json: matched in code by usableBranches.
  branchIds     Json
  licenseNo     String?
  /// The sign-in email: typed by the Owner, or derived by the seed (staffEmail in @pedia/seed).
  email         String
  deactivatedAt DateTime?
  /// List order, as the clinic added them (the mock's array order). New staff go last (B3).
  position      Int       @default(0)

  /// One login per email per account, deactivated logins included (decision #27). StaffService also checks it, with
  /// parents' emails, under the clinic's lock (B3, Decision 4); this is the backstop.
  @@unique([clinicId, email])
}

/// One login's secrets, staff or guardian, in one clinic account. Never served.
/// Platform: sign-in finds it by email across clinic accounts before one is chosen (decision #27). Every query names
/// clinicId itself. Only IdentityService, SessionService and the seed read it.
model Credential {
  id           String  @id @default(cuid(2))
  clinicId     String
  /// The login as sessions and the audit trail name it: the staff id, or `guardian.<guardianId>` (as the mock).
  accountId    String
  /// Null: a parent who signs in with their mobile only (B11 decision 14: their email is another login's).
  email        String?
  /// A parent's mobile sign-in, smsNumber form (639XXXXXXXXX). It follows the guardian's number (B11 decision 15).
  phone        String? @db.VarChar(16)
  staffId      String?
  guardianId   String?
  /// A guardian's name until B4 brings guardians. A staff login's name is read from Staff.
  name         String
  passwordHash String
  /// A login the Owner just made: must choose its own password first (decision #21).
  mustChange   Boolean @default(false)
  /// Staff only. The PIN for switching user on a shared device (decision #24).
  pinHash      String?
  /// ISO times of recent wrong PINs inside PIN_POLICY's window (pinAttempt keeps only those).
  pinFailedAt  Json

  @@unique([clinicId, accountId])
  /// One mobile, one sign-in per clinic (B11 decision 14): the backstop under PortalService's checks.
  @@unique([clinicId, phone])
  @@index([email])
  @@index([phone])
}

enum PortalAccountState {
  invited
  active
  off
}

/// One guardian's portal access in one clinic (B11 E7). No row = not invited. `active`: a parent Credential exists;
/// turning off deletes it and its sessions, so a new invite starts clean (decision 18).
model PortalAccount {
  clinicId    String
  guardianId  String             @db.VarChar(64)
  state       PortalAccountState
  invitedAt   DateTime?
  /// Who sent the latest invite (a staff name, as the audit trail shows it).
  invitedBy   String?            @db.VarChar(191)
  activatedAt DateTime?
  turnedOffAt DateTime?

  @@id([clinicId, guardianId])
}

enum PortalLinkPurpose {
  invite
  reset
}

/// An invite or reset link (B11 decisions 5, 6). Platform: the signed-out link routes find it by the token's hash
/// before a clinic is known; every query names clinicId itself. The token is made when the text is sent (E5) and only
/// its SHA-256 is kept.
model PortalLink {
  id          String            @id @default(cuid(2))
  clinicId    String
  guardianId  String            @db.VarChar(64)
  purpose     PortalLinkPurpose
  /// SHA-256 of the token, hex. Null until the text is sent; a resent text replaces it.
  tokenHash   String?           @unique @db.Char(64)
  /// Demo deployments only (DEMO_LOGINS): the token itself, for GET /auth/demo-texts (E6).
  demoToken   String?           @db.VarChar(64)
  createdAt   DateTime
  expiresAt   DateTime
  usedAt      DateTime?
  cancelledAt DateTime?

  @@index([clinicId, guardianId, purpose])
  @@index([expiresAt])
}

/// A signed-in clinic login. Platform: the guard finds it by the cookie's token hash before it knows the clinic.
/// Deleted on sign-out or expiry (not append-only: sign-ins are recorded in AuditEvent).
model Session {
  id         String   @id @default(cuid(2))
  /// SHA-256 of the pd_session token, hex. The token itself is never stored.
  tokenHash  String   @unique @db.Char(64)
  clinicId   String
  accountId  String
  createdAt  DateTime
  /// Moved forward at most once a minute (SessionService.TOUCH_EVERY_MS). Idle expiry reads it.
  lastSeenAt DateTime
  /// createdAt + 8 h: the absolute limit, however active the session is.
  expiresAt  DateTime

  @@index([clinicId, accountId])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

/// Primolar's own staff (decisions #3, #25). Never a clinic user: no clinicId, no role.
model OperatorUser {
  id           String @id @default(cuid(2))
  name         String
  email        String @unique
  passwordHash String
}

/// A signed-in operator, on its own cookie (pd_operator) and its own table, so it can't be mistaken for a clinic
/// session, or the reverse.
model OperatorSession {
  id         String   @id @default(cuid(2))
  tokenHash  String   @unique @db.Char(64)
  operatorId String
  createdAt  DateTime
  lastSeenAt DateTime
  expiresAt  DateTime

  @@index([operatorId])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

/// A clinic's acceptance of Primolar's Terms and DPA (ClinicAgreement). Append-only; the newest per clinic is in
/// force. Platform: Primolar's record (root CONVENTIONS: agreements are never inside a tenant).
model Agreement {
  id           String          @id @default(cuid(2))
  clinicId     String
  termsVersion Int
  dpaVersion   Int
  acceptedBy   String
  at           DateTime
  method       AgreementMethod
  /// The date a paper copy was signed (on_file only), Asia/Manila.
  signedOn     DateTime?       @db.Date

  @@index([clinicId, at])
}

/// One login's reading of a confidentiality or notice version (privacy #20, #21). Append-only.
model Acknowledgement {
  id        String           @id @default(cuid(2))
  clinicId  String
  kind      AcknowledgedKind
  version   Int
  accountId String
  name      String
  at        DateTime

  @@index([clinicId, accountId, kind, version])
}

/// One saved version of a clinic's privacy notice (privacy #19). Append-only; the highest version is in force.
model PrivacyNotice {
  id           String   @id @default(cuid(2))
  clinicId     String
  version      Int
  body         String   @db.Text
  contactName  String
  contactEmail String
  savedByName  String
  at           DateTime

  @@unique([clinicId, version])
}

/// A treatment chair (Chair in @pedia/shared). Belongs to one branch, but MODEL_SCOPE is "clinic": GET /chairs is
/// account-wide, so a chair in a child's history resolves whichever branch the device is on (B3, Decision 8).
model Chair {
  id       String @id @default(cuid(2))
  clinicId String
  branchId String
  name     String
  /// List order (the mock's array order). New chairs go last.
  position Int    @default(0)

  @@index([clinicId, branchId])
}

/// One billable procedure (Procedure in @pedia/shared). `code` is the contract's key: note templates, plan items and
/// follow-up rules name it, so it is the primary key with the clinic (B3, Decision 7).
model Procedure {
  clinicId           String
  code               String  @db.VarChar(64)
  name               String
  defaultDurationMin Int
  /// Centavos (CONVENTIONS → Data: money is Int).
  fee                Int
  /// The fee is charged per tooth treated.
  perTooth           Boolean
  position           Int     @default(0)

  @@id([clinicId, code])
}

/// A clinical note's form (NoteTemplate in @pedia/shared). Ids (`tpl_oral_exam`) repeat in every clinic, so the
/// primary key is (clinicId, id). `fields` is TemplateField[], parsed with that schema on read; never filtered on.
model NoteTemplate {
  clinicId  String
  id        String @db.VarChar(64)
  name      String
  /// A Procedure.code.
  procedure String @db.VarChar(64)
  fields    Json
  position  Int    @default(0)

  @@id([clinicId, id])
}

/// Mirrors MessageKind in packages/shared/src/schemas/message.ts (tenant-scope.test.ts checks they match).
enum MessageKind {
  appointment_confirmation
  appointment_reminder
  post_extraction
  post_pulpotomy
  fluoride_instructions
  pre_treatment
  missed_appointment
  follow_up_reminder
  recall
  birthday
}

/// What the log holds (LoggedMessageKind in @pedia/shared): the template kinds above plus the account texts (B11 E4).
enum LoggedMessageKind {
  appointment_confirmation
  appointment_reminder
  post_extraction
  post_pulpotomy
  fluoride_instructions
  pre_treatment
  missed_appointment
  follow_up_reminder
  recall
  birthday
  portal_invite
  password_reset
}

/// A parent message's wording (MessageTemplate in @pedia/shared): one per kind per clinic, edited on the Messages page.
model MessageTemplate {
  clinicId  String
  kind      MessageKind
  name      String
  /// At most 480 characters (TemplateBody), placeholders checked by the shared schema.
  body      String      @db.VarChar(480)
  updatedAt DateTime
  position  Int         @default(0)

  @@id([clinicId, kind])
}

/// Mirrors MessageStatus in packages/shared/src/schemas/message.ts (tenant-scope.test.ts checks they match).
enum MessageStatus {
  queued
  sent
  failed
  cancelled
}

/// Mirrors MessageChannel (SMS only, decision 1).
enum MessageChannel {
  sms
}

/// One text to a primary guardian: the log in /messages (features/messages/mocks.ts). Rendered when queued, so a later
/// template edit doesn't rewrite it. Sent through one OutboxMessage ("message.send", payload { messageId }). Written
/// only by MessageQueueService (B9 E1).
model Message {
  id            String            @id @default(cuid(2))
  clinicId      String
  patientId     String
  kind          LoggedMessageKind
  channel       MessageChannel    @default(sms)
  /// The guardian's phone as stored (the contract's `to`); normalised only when sent (smsNumber).
  to            String            @db.VarChar(32)
  recipientName String            @db.VarChar(191)
  /// The rendered body: a 480-character template can render longer, so TEXT.
  body          String            @db.Text
  status        MessageStatus     @default(queued)
  /// When it goes out: already inside sending hours (nextSendingTime, E4).
  sendAt        DateTime
  appointmentId String?
  noteId        String?
  dueItemId     String?
  /// A FAILURE reason from @pedia/shared. Never a provider's or library's message.
  failureReason String?           @db.VarChar(191)
  createdAt     DateTime
  /// Birthday rows only: the Manila year it greets. The unique below makes "once a year" hold under races (E9).
  greetingYear  Int?
  /// Set before the provider is called (E3). Set with no outcome = in doubt: never sent again.
  dispatchedAt  DateTime?
  sentAt        DateTime?
  /// Parts the provider billed (smsSegments), for the monthly count (E10).
  segments      Int?
  providerRef   String?           @db.VarChar(64)
  /// Account texts only (B11 E5): the PortalLink whose token the sender puts in place of [link].
  linkId        String?

  @@unique([clinicId, patientId, greetingYear])
  /// B11: a resend or turn-off withdraws its texts by link, without scanning (and locking) the clinic's whole log.
  @@index([clinicId, linkId])
  @@index([clinicId, sendAt])
  @@index([clinicId, patientId, status, sendAt])
  @@index([clinicId, appointmentId])
  @@index([clinicId, dueItemId])
  @@index([clinicId, sentAt])
  /// B12 E9: the month's billed parts are summed by when each text was handed to the provider.
  @@index([clinicId, dispatchedAt])
}

/// Demo deployments only (DEMO_LOGINS=true): the sign-in page's one-click accounts, with the PIN shown in the clear,
/// because PINs are otherwise stored only as hashes. Written only by the seed. Platform: served before sign-in.
model DemoLogin {
  id        String  @id @default(cuid(2))
  clinicId  String
  accountId String
  role      Role
  name      String
  email     String
  summary   String
  pin       String? @db.Char(4)
  /// Order on the login screen (demoAccounts' order).
  position  Int
  /// One of the per-role logins listed on the sign-in page (demoLogins in @pedia/seed).
  featured  Boolean @default(false)

  @@index([clinicId, position])
}

/// Fixed-window request counters for the auth routes (CONVENTIONS → Stateless instances: rate-limit counters live in
/// MySQL, so every instance shares them). Platform: counted before anyone is signed in. Written only by
/// RateLimitService, with raw SQL (INSERT … ON DUPLICATE KEY UPDATE). Old windows are swept by B1-c's scheduler.
model RateLimitCounter {
  /// `<group>:<client ip>`, e.g. `login:203.0.113.7` (rate-limit.ts → bucketOf).
  bucket      String   @db.VarChar(191)
  windowStart DateTime
  hits        Int

  @@id([bucket, windowStart])
  @@index([windowStart])
}

/// Where a row stands. `pending` covers both "waiting" and "leased": a lease is `availableAt` moved forward (B1-c plan).
enum OutboxStatus {
  pending
  done
  failed
}

/// Side effects leaving the system (SMS, email, webhooks), written in the same transaction as the change that caused
/// them and sent by OutboxWorker (CONVENTIONS → Side effects). Platform: the worker reads across clinics; each
/// handler runs inside the row's clinic. Written only by OutboxService and OutboxWorker.
model OutboxMessage {
  id          String       @id @default(cuid(2))
  /// The clinic the side effect belongs to; null for platform mail (sign-ups, B12).
  clinicId    String?
  /// Which OutboxHandler runs it ("noop"; B9 adds message kinds).
  kind        String       @db.VarChar(64)
  /// Ids and flags only, never patient data: the handler loads what it sends.
  payload     Json
  status      OutboxStatus @default(pending)
  /// Not before this moment: a scheduled send (B9's reminders), a retry's backoff, or a running lease.
  availableAt DateTime
  /// Claims so far. A settle only counts if it still matches its claim's number.
  attempts    Int          @default(0)
  /// The error's name and Prisma code only. Messages can quote personal data.
  lastError   String?      @db.VarChar(191)
  createdAt   DateTime
  processedAt DateTime?

  @@index([status, availableAt])
  @@index([status, processedAt])
}

/// One row per scheduled job: a lease that one API instance holds per run (JobRunner). Platform.
model JobLock {
  name           String    @id @db.VarChar(64)
  lockedUntil    DateTime
  /// `<host>:<pid>:<random>` of the holder, for diagnosis only.
  lockedBy       String    @db.VarChar(191)
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
}

/// Mirrors Sex in packages/shared/src/schemas/patient.ts (tenant-scope.test.ts checks they match).
enum Sex {
  male
  female
}

/// Mirrors ConsentScope in packages/shared/src/schemas/patient.ts (tenant-scope.test.ts checks they match).
enum ConsentScope {
  general_treatment
  local_anesthesia
  extraction
  radiographs
  clinical_photos
  sedation
}

/// Mirrors PrivacyChoice.by in packages/shared/src/schemas/legal.ts (tenant-scope.test.ts checks they match).
enum PrivacyChoiceBy {
  staff
  parent
}

/// A child's record (Patient in @pedia/shared). Responses are built only by visibleTo (src/patients/patient.views.ts),
/// which leaves the address, the emergency contact and guardian phones and emails out without patients.contact.
/// Never deleted. Seeded ids (UUIDs) are kept, so MSW's visits and invoices in `hybrid` still point at them.
model Patient {
  id                String    @id @default(cuid(2))
  clinicId          String
  /// KS-00042: the clinic's chart number, assigned under the clinic's lock (nextPatientNo). Never reused.
  patientNo         String    @db.VarChar(16)
  firstName         String
  lastName          String
  nickname          String?   @db.VarChar(30)
  birthDate         DateTime  @db.Date
  sex               Sex
  address           String?   @db.Text
  emergencyName     String?
  emergencyPhone    String?
  /// string[] each: read whole, parsed with the shared schema, never filtered on.
  allergies         Json
  noKnownAllergies  Boolean?
  medicalConditions Json
  medications       Json
  noKnownConditions Boolean?
  alerts            Json
  /// PatientTag[] or null (the contract's `tags` is optional: absent is not []).
  tags              Json?
  /// { previousClinic, notes }.
  dentalHistory     Json
  /// PatientProfile or null.
  profile           Json?
  /// The storage key of the child's photo (StorageService), or null. Set only by the photo routes.
  photoRef          String?
  photoUpdatedAt    DateTime?
  createdAt         DateTime
  /// Decision 1: lowercased child and guardian names (patientSearchText), matched with LIKE per word. Never served.
  searchNames       String    @db.Text
  /// Decision 1: every guardian phone, digits only. Matched only for callers holding patients.contact. Never served.
  searchPhones      String    @db.VarChar(512)
  /// B13c2b E6: an approved erasure request restricted the record. Only privacy.manage reads it; it leaves every list,
  /// search and family (PatientsService.where, FamilyService.childrenOf). Anonymised later by B13c2b-2, never cleared here.
  restrictedAt      DateTime?
  /// B13c2b-2 (D4): when ErasureService.anonymise de-identified this restricted record. Set once; restrictedAt stays set.
  anonymisedAt      DateTime?

  @@unique([clinicId, patientNo])
  /// The list's order (lastName, firstName, id) and name lookups.
  @@index([clinicId, lastName, firstName])
  /// Duplicate detection: same birth date first, then the names compared in code (findDuplicates).
  @@index([clinicId, birthDate])
  /// B13c2b: the guard's "which children are restricted here" (PatientRestrictions), one small read per patient route.
  @@index([clinicId, restrictedAt])
}

/// One guardian of one child (Guardian in @pedia/shared). Siblings carry the same guardianId, each in their own row:
/// a PUT replaces only that child's rows (as the mock), and PATCH's phone follows the guardianId to every child.
model PatientGuardian {
  clinicId     String
  patientId    String
  /// The contract's Guardian.id, chosen by the web (and the seed). A parent login is `guardian.<guardianId>`.
  guardianId   String  @db.VarChar(64)
  fullName     String
  relationship String
  phone        String  @db.VarChar(32)
  email        String?
  isPrimary    Boolean
  /// The guardians' order on the record (the mock's array order).
  position     Int     @default(0)

  @@id([clinicId, patientId, guardianId])
  /// A parent's children (decision 5), and PATCH's phone following the guardian.
  @@index([clinicId, guardianId])
  /// Siblings: children sharing a guardian phone (siblingsOf).
  @@index([clinicId, phone])
}

/// A treatment consent (ConsentRecord in @pedia/shared). Append-only: APPEND_ONLY in src/prisma/model-scope.ts.
model PatientConsent {
  id         String       @id @default(cuid(2))
  clinicId   String
  patientId  String
  guardianId String       @db.VarChar(64)
  scope      ConsentScope
  date       DateTime     @db.Date
  createdAt  DateTime

  @@index([clinicId, patientId, createdAt])
}

/// The parent's required privacy consent (PrivacyConsent in @pedia/shared, privacy #12, #16, #17). Recorded once per
/// child: the key refuses a second. Append-only. The guardian's name and relationship are copied as they were then (#23).
model PatientPrivacyConsent {
  clinicId       String
  patientId      String
  guardianId     String   @db.VarChar(64)
  guardianName   String
  relationship   String
  noticeVersion  Int
  formVersion    Int
  recordedById   String
  recordedByName String
  at             DateTime

  @@id([clinicId, patientId])
}

/// One state of the optional consents (PrivacyChoice in @pedia/shared, privacy #13–#15). Append-only; the highest
/// position is in force (currentChoices).
model PrivacyChoice {
  id        String          @id @default(cuid(2))
  clinicId  String
  patientId String
  position  Int
  photos    Boolean
  reminders Boolean
  by        PrivacyChoiceBy
  byName    String
  at        DateTime

  @@unique([clinicId, patientId, position])
}

/// Mirrors PrivacyRequestKind, …Channel and …Status in packages/shared/src/schemas/privacy-requests.ts.
enum PrivacyRequestKind {
  access
  correction
  erasure
  objection
  other
}

enum PrivacyRequestChannel {
  in_person
  phone
  text
  email
  letter
}

enum PrivacyRequestStatus {
  open
  done
  declined
}

/// B13c2b: the register of data-subject requests (RA 10173), logged by the Owner or an admin (privacy.manage). Kept
/// (RETENTION_SCHEDULE: proof of how a request was answered, confirm with counsel). Closed once; never deleted.
model PrivacyRequest {
  id            String                @id @default(cuid(2))
  clinicId      String
  /// Absent for a request about no one child (a general objection). Required for an erasure (the shared input).
  patientId     String?
  kind          PrivacyRequestKind
  requesterName String                @db.VarChar(120)
  relationship  String?               @db.VarChar(60)
  channel       PrivacyRequestChannel
  details       String?               @db.VarChar(500)
  receivedOn    DateTime              @db.Date
  /// addWorkingDays(receivedOn, PRIVACY_REQUEST_DUE_WORKING_DAYS) when logged (E3): a later setting moves nothing.
  dueOn         DateTime              @db.Date
  status        PrivacyRequestStatus  @default(open)
  outcome       String?               @db.VarChar(500)
  loggedById    String
  loggedByName  String
  loggedAt      DateTime
  closedById    String?
  closedByName  String?
  closedAt      DateTime?

  /// The open list, soonest due first.
  @@index([clinicId, status, dueOn])
  /// The closed pages, newest closed first (keyset on closedAt, id).
  @@index([clinicId, status, closedAt])
}

/// Mirrors VisitStatus in packages/shared/src/schemas/visit.ts (tenant-scope.test.ts checks they match).
enum VisitStatus {
  in_progress
  completed
}

/// One sitting in the chair (Visit in @pedia/shared). Chart entries, and from B6 notes and growth, attach to it. At most
/// one in progress per patient: every write locks the patient's row first (lockPatient). The only update is completing.
/// Seeded ids (UUIDs, `visit_roster_<n>`) are kept, so MSW's notes and plan items in `hybrid` still point at them.
model Visit {
  id            String      @id @default(cuid(2))
  clinicId      String
  patientId     String
  dentistId     String
  /// The appointment it was started from (B7): checked and seated (arrived → in chair) on start, done on complete.
  appointmentId String?
  /// The clinic's calendar day it started on (Clock.today(), Asia/Manila).
  date          DateTime    @db.Date
  status        VisitStatus
  startedAt     DateTime
  completedAt   DateTime?

  /// The visit list, newest first, and the one in progress.
  @@index([clinicId, patientId, startedAt])
  /// The last visit's day per patient (VisitDaysService): completed only, MAX(date).
  @@index([clinicId, patientId, status, date])
}

/// Mirrors ToothCondition in packages/shared/src/schemas/chart.ts (tenant-scope.test.ts checks they match).
enum ToothCondition {
  sound
  caries
  restored
  sealant
  fluoride
  pulpotomy
  pulpectomy
  extracted
  missing
  unerupted
  erupting
}

/// One finding on one tooth (ChartEntry in @pedia/shared). Append-only: APPEND_ONLY in src/prisma/model-scope.ts refuses
/// every update and delete. A correction is a new row naming the one it replaces in `supersedes`. The chart is
/// deriveChart() over these rows, in the web and in the tests, never stored.
model ChartEntry {
  id         String         @id @default(cuid(2))
  clinicId   String
  patientId  String
  visitId    String
  /// FDI number (ALL_TEETH), checked by the shared schema.
  tooth      Int
  /// Surface[] in the order given; [] is the whole tooth. Read whole, never filtered on.
  surfaces   Json
  condition  ToothCondition
  note       String?        @db.Text
  /// The visit's dentist (the mock's rule), not the caller.
  recordedBy String
  recordedAt DateTime
  supersedes String?

  /// An entry is corrected once (the mock's 409). The service checks it under the patient's lock; this is the backstop.
  /// MySQL allows many NULLs in a unique index, so uncorrected entries don't collide.
  @@unique([clinicId, supersedes])
  /// A patient's whole history, oldest first: GET /patients/:id/chart and every write's deriveChart (CHUNKS B5).
  @@index([clinicId, patientId, recordedAt])
}

/// The plan item's state. `done` only by signing a matching note (itemsCompletedBy); progress is never stored.
enum PlanItemStatus {
  planned
  in_progress
  done
  declined
}

/// B6: a clinical note from a template (features/notes/mocks.ts). A draft is edited in place; a signed note is
/// read-only, enforced in NotesService (every change is an update guarded by `signedAt IS NULL`, decision 6).
model ClinicalNote {
  id           String    @id @default(cuid(2))
  clinicId     String
  patientId    String
  visitId      String
  /// A NoteTemplate.id of this clinic.
  templateId   String    @db.VarChar(64)
  /// The values noteValuesSchema(template) returned: checked, unknown keys dropped. Read whole, never filtered on.
  values       Json
  /// BehaviorRating[] in the order given (behaviour tracking, feature 9).
  behavior     Json
  /// Absent is null; "" is kept as given, as the mock. BEHAVIOR_NOTE_MAX (300) characters on input.
  behaviorNote String?   @db.VarChar(300)
  /// The visit's dentist (the mock's rule), not the caller.
  authorId     String
  createdAt    DateTime
  signedAt     DateTime?

  /// GET /patients/:id/notes, newest first.
  @@index([clinicId, patientId, createdAt])
}

/// B6: growth and development as observed at one visit (features/growth/mocks.ts). Re-saving replaces it.
model GrowthRecord {
  id         String   @id @default(cuid(2))
  clinicId   String
  patientId  String
  visitId    String
  /// HabitObservation[]: the ticked habits, in the order given.
  habits     Json
  speech     String?  @db.Text
  /// When it was last saved: a re-save moves it, as the mock's.
  recordedAt DateTime

  /// One record per visit. GrowthService replaces it under the patient's lock; this is the backstop.
  @@unique([clinicId, visitId])
  /// GET /patients/:id/growth, oldest first.
  @@index([clinicId, patientId, recordedAt])
}

/// B6: one planned treatment (features/plan/mocks.ts). Status changes in place; `done` only through a signed note.
model PlanItem {
  id                 String         @id @default(cuid(2))
  clinicId           String
  patientId          String
  /// A Procedure.code of this clinic.
  procedureCode      String         @db.VarChar(64)
  /// FDI number, checked by the shared schema. Null: the item isn't per tooth.
  tooth              Int?
  /// Centavos (CONVENTIONS → Data: money is Int).
  fee                Int
  status             PlanItemStatus
  /// Stored as given, as the mock (decision 4).
  sourceChartEntryId String?
  completedVisitId   String?
  completedNoteId    String?
  createdAt          DateTime

  /// GET /patients/:id/plan, oldest first, and sign's lookup of a patient's open items.
  @@index([clinicId, patientId, createdAt])
}

enum AppointmentStatus {
  booked
  confirmed
  arrived
  in_chair
  done
  no_show
  cancelled
}

/// features/appointments/mocks.ts. Branch-owned in the contract, read account-wide (conflicts across branches, a child's
/// appointments, branch=all reports), so "clinic" in MODEL_SCOPE with branchId as a plain column (E5). Every read and
/// write goes through AppointmentRecordsService (E4).
model Appointment {
  id            String            @id @default(cuid(2))
  clinicId      String
  branchId      String
  patientId     String
  dentistId     String
  chairId       String
  startsAt      DateTime
  durationMin   Int
  reason        String            @db.Text
  procedureCode String?           @db.VarChar(64)
  status        AppointmentStatus
  cancelReason  String?           @db.Text
  sourceRuleId  String?           @db.VarChar(64)

  @@index([clinicId, branchId, startsAt])
  @@index([clinicId, chairId, startsAt])
  @@index([clinicId, dentistId, startsAt])
  @@index([clinicId, patientId, startsAt])
}

enum TimeOfDay {
  morning
  afternoon
  any
}

enum AppointmentRequestStatus {
  pending
  handled
}

/// A parent's request from the portal (appointments/mocks.ts:137–183). Not an appointment: staff book it.
model AppointmentRequest {
  id            String                   @id @default(cuid(2))
  clinicId      String
  patientId     String
  guardianId    String
  preferredDate DateTime                 @db.Date
  timeOfDay     TimeOfDay
  reason        String                   @db.VarChar(200)
  note          String?                  @db.VarChar(500)
  status        AppointmentRequestStatus
  createdAt     DateTime

  @@index([clinicId, status, createdAt])
  @@index([clinicId, patientId, createdAt])
}

enum DueKind {
  follow_up
  recall
}

/// A follow-up or recall a signed note made due (dueItemFor). Open is computed (isDueItemOpen), never stored.
model DueItem {
  id            String    @id @default(cuid(2))
  clinicId      String
  patientId     String
  ruleId        String    @db.VarChar(64)
  kind          DueKind
  procedure     String    @db.VarChar(64)
  dueOn         DateTime  @db.Date
  sourceNoteId  String
  visitId       String
  appointmentId String?
  closedAt      DateTime?
  createdAt     DateTime

  @@unique([clinicId, sourceNoteId])
  @@index([clinicId, closedAt, dueOn])
  @@index([clinicId, patientId, procedure])
}

enum PaymentMethod {
  cash
  gcash
  maya
  card
  bank_transfer
  account_credit
}

/// A bill (B8). Branch-level data read account-wide (a family's balance sums every branch): "clinic" scope, branchId
/// a plain column (E5). Totals and balances are computed, never stored.
model Invoice {
  id            String    @id @default(cuid(2))
  clinicId      String
  branchId      String
  patientId     String
  visitId       String?
  appointmentId String?
  /// Centavos.
  discount      Int
  issuedAt      DateTime
  /// Decision 2: set together, once, by POST /invoices/:id/void.
  voidedAt      DateTime?
  voidedBy      String?
  voidReason    String?   @db.Text

  @@index([clinicId, patientId, issuedAt])
  /// The finance report's month and outstanding, per branch.
  @@index([clinicId, branchId, issuedAt])
  /// Unpaid appointments: an appointment's bills.
  @@index([clinicId, appointmentId])
}

/// One line, in order. Names and fees copied at billing, so a catalog change never rewrites an issued bill.
model InvoiceLine {
  id             String  @id @default(cuid(2))
  clinicId       String
  invoiceId      String
  position       Int
  planItemId     String?
  /// planItemId while the bill is live, null once voided: a plan item is on one live bill at most (E6).
  livePlanItemId String?
  procedureCode  String  @db.VarChar(64)
  description    String  @db.Text
  tooth          Int?
  amount         Int

  @@unique([clinicId, invoiceId, position])
  @@unique([clinicId, livePlanItemId])
}

/// Append-only (APPEND_ONLY). Refunds are negative rows. A credit application is one bill-side row (leg 0) and one
/// or more deposit-side rows (legs 1…) under one CR number (E3).
model Payment {
  id          String        @id @default(cuid(2))
  clinicId    String
  branchId    String
  patientId   String
  invoiceId   String?
  appliedTo   String?
  amount      Int
  method      PaymentMethod
  referenceNo String?       @db.VarChar(100)
  note        String?       @db.Text
  receiptNo   String        @db.VarChar(16)
  receiptLeg  Int           @default(0)
  receivedBy  String
  receivedAt  DateTime

  @@unique([clinicId, receiptNo, receiptLeg])
  @@index([clinicId, patientId, receivedAt])
  @@index([clinicId, invoiceId])
  /// The day's collections and the finance sums, per branch.
  @@index([clinicId, branchId, receivedAt])
}

/// The last receipt number given, per clinic and series (AR, CR). Gapless (E3).
model ReceiptCounter {
  clinicId String
  series   String @db.VarChar(2)
  last     Int

  @@id([clinicId, series])
}

/// A money-moving POST's key and its answer (E2), kept 24 hours, swept hourly.
model IdempotencyKey {
  clinicId    String
  key         String   @db.VarChar(100)
  fingerprint String   @db.Char(64)
  status      Int
  response    Json?
  createdAt   DateTime
  expiresAt   DateTime

  @@id([clinicId, key])
  @@index([expiresAt])
}

/// B10: ClinicalPhoto.type in @pedia/shared. `document`: a medical document a parent photographed or scanned.
enum PhotoType {
  intraoral
  extraoral
  xray
  referral
  document
}

enum PhotoStage {
  before
  after
}

enum UploadedBy {
  staff
  parent
}

/// B10: a clinical photo or a parent's medical document (features/photos/mocks.ts). Append-only: photos are part of the
/// medical record and are never edited or deleted (decision 5). The bytes are in storage under `fileKey`.
model ClinicalPhoto {
  id          String      @id @default(cuid(2))
  clinicId    String
  patientId   String
  visitId     String?
  type        PhotoType
  stage       PhotoStage?
  tooth       Int?
  takenOn     DateTime    @db.Date
  /// Unbounded in the contract, so TEXT.
  caption     String      @db.Text
  /// The sniffed type (E4), never the browser's claim.
  contentType String      @db.VarChar(64)
  uploadedBy  UploadedBy
  /// clinics/<clinicId>/photos/<uuid>.<ext>, built by StorageService.
  fileKey     String      @db.VarChar(191)
  bytes       Int
  createdAt   DateTime

  /// GET /patients/:id/photos, newest takenOn then createdAt.
  @@index([clinicId, patientId, takenOn, createdAt])
}

/// B10: DocumentType in @pedia/shared (feature 13).
enum DocumentType {
  dental_certificate
  treatment_plan
  consent_form
  referral_letter
  clearance
  dental_clearance
  post_op_instructions
  prescription
  receipt
  patient_summary
  notes_report
  privacy_consent
}

/// B10: one issued document (features/documents/mocks.ts). Append-only; the PDF is built in the browser and never
/// stored (decision 6). `details` and `items` are stored as given after GenerateDocumentInput parsed them.
model PatientDocument {
  id        String       @id @default(cuid(2))
  clinicId  String
  patientId String
  type      DocumentType
  title     String       @db.Text
  /// The visit, payment or signed note it came from, checked when one is required; otherwise kept as given (as the mock).
  sourceId  String?      @db.VarChar(191)
  details   Json?
  items     Json?
  issuedBy  String       @db.VarChar(191)
  createdAt DateTime

  /// GET /documents (clinic-wide, newest first) and GET /patients/:id/documents.
  @@index([clinicId, createdAt])
  @@index([clinicId, patientId, createdAt])
}

/// B10 (E5): every file a clinic keeps, written and removed only by StorageService. SUM(bytes) is the clinic's storage.
model StoredFile {
  id        String   @id @default(cuid(2))
  clinicId  String
  key       String   @unique @db.VarChar(191)
  /// A StorageArea: branding, patients, photos.
  area      String   @db.VarChar(32)
  bytes     Int
  createdAt DateTime

  @@index([clinicId])
}

// ---------- B12: Primolar's billing (platform; every query names clinicId itself where the row has one) ----------

/// Mirrors BrandingChoice in packages/shared/src/schemas/signup.ts.
enum BrandingChoice {
  own
  default
  designed
}

enum SignupSource {
  form
  console
}

/// Mirrors SignupStatus in packages/shared/src/schemas/signup.ts.
enum SignupStatus {
  waiting
  approved
  rejected
}

/// Mirrors DesignStatus in packages/shared/src/schemas/signup.ts.
enum DesignStatus {
  in_progress
  delivered
}

/// Mirrors SubscriptionPause in packages/shared/src/schemas/subscription.ts.
enum SubscriptionPause {
  overdue
  cancelled
}

/// Who a receipt is from (ReceiptPayer.kind).
enum ReceiptPurpose {
  signup
  subscription
}

/// Mirrors ReceiptStatus in packages/shared/src/schemas/payments.ts.
enum ReceiptStatus {
  pending
  confirmed
  rejected
}

/// The price list in force and Primolar's payment QR (B12 decisions 5, 11). One row, id "primolar": also the platform
/// lock (E6), taken first. Centavos, VAT-inclusive.
model PlatformSettings {
  id                 String    @id
  smallSetupFee      Int
  smallMonthlyFee    Int
  midSetupFee        Int
  midMonthlyFee      Int
  bigSetupFee        Int
  bigMonthlyFee      Int
  designAddOn        Int
  paymentQrKey       String?   @db.VarChar(191)
  paymentQrCaption   String?   @db.VarChar(120)
  paymentQrUpdatedAt DateTime?
}

/// B12 decision 11: each saved price change keeps the list in force before `on` (Manila), so a month is billed at its
/// start's list. Append-only.
model PriceChange {
  id              String   @id @default(cuid(2))
  on              DateTime @db.Date
  smallSetupFee   Int
  smallMonthlyFee Int
  midSetupFee     Int
  midMonthlyFee   Int
  bigSetupFee     Int
  bigMonthlyFee   Int
  designAddOn     Int
  createdAt       DateTime

  @@index([on])
}

/// One sign-up (Signup in @pedia/shared): from the Get started form or the console. Outside every tenant until
/// approved; `clinicId` is the account it became. Mapped both ways by signups/signup.rows.ts.
model Signup {
  id                 String          @id @default(cuid(2))
  reference          String          @unique @db.Char(13)
  source             SignupSource
  submittedAt        DateTime
  name               String
  /// clinicNameKey(name): the duplicate check (billing #10).
  nameKey            String          @db.VarChar(191)
  contactEmail       String
  contactEmailKey    String          @db.VarChar(191)
  tin                String
  tier               Tier
  branchName         String
  branchAddress      String
  branchPhone        String
  /// OpeningHours (@pedia/shared), as Branch stores it.
  branchOpeningHours Json
  ownerName          String
  ownerEmail         String
  ownerRole          StaffRole
  branding           BrandingChoice
  brandColor         String?         @db.Char(7)
  headingFont        HeadingFont?
  brief              String?         @db.Text
  logoKey            String?         @db.VarChar(191)
  /// Up to three file keys (string[]), parsed with z.array(z.string()).max(3) on read.
  referenceKeys      Json
  quoteSetupFee      Int
  quoteFirstMonth    Int
  quoteDesignAddOn   Int
  quoteTotal         Int
  quoteVat           Int
  paymentMethod      PaymentMethod?
  paymentReference   String?         @db.VarChar(60)
  paidOn             DateTime?       @db.Date
  paymentAmount      Int?
  paymentRecordedAt  DateTime?
  status             SignupStatus
  rejectionReason    String?         @db.Text
  rejectedAt         DateTime?
  clinicId           String?         @unique
  approvedAt         DateTime?
  designStatus       DesignStatus?
  designDeliveredAt  DateTime?
  termsVersion       Int
  dpaVersion         Int
  acceptedBy         String
  agreedAt           DateTime
  agreementMethod    AgreementMethod
  signedOn           DateTime?       @db.Date
  /// B12 decision 15: the logo and images deleted 30 days after a rejection.
  filesDeletedAt     DateTime?

  @@index([status, submittedAt])
  @@index([nameKey])
  @@index([contactEmailKey])
  @@index([status, rejectedAt])
}

/// A clinic's monthly subscription (Subscription in @pedia/shared). One per clinic; the plan itself is ClinicAccount.tier.
model Subscription {
  clinicId       String             @id
  anchor         DateTime           @db.Date
  paidMonths     Int
  downgradeTier  Tier?
  downgradeOn    DateTime?          @db.Date
  priceTier      Tier?
  priceTierUntil DateTime?          @db.Date
  cancelledAt    DateTime?
  pause          SubscriptionPause?
}

/// One month paid to Primolar and its invoice (billing #29, #33). Append-only. One per month: the race backstop.
model SubscriptionPayment {
  id          String        @id @default(cuid(2))
  clinicId    String
  invoiceNo   String        @unique @db.VarChar(16)
  tier        Tier
  periodStart DateTime      @db.Date
  periodEnd   DateTime      @db.Date
  method      PaymentMethod
  reference   String?       @db.VarChar(60)
  paidOn      DateTime      @db.Date
  amount      Int
  recordedAt  DateTime
  /// The receipt it was confirmed from (B12 decision 6), if any.
  receiptId   String?       @unique

  @@unique([clinicId, periodStart])
  @@index([clinicId, recordedAt])
}

/// One line of a Primolar invoice (S15). Append-only.
model SubscriptionLine {
  id        String @id @default(cuid(2))
  paymentId String
  position  Int
  label     String @db.VarChar(191)
  amount    Int

  @@unique([paymentId, position])
}

/// Gapless PRM-INV-##### (one row, id "primolar"): always the last lock taken (E6).
model InvoiceCounter {
  id   String @id
  next Int
}

/// A receipt a sign-up or a clinic sent after paying by QR (B12 decisions 6–8, 21–24). Not append-only: its status is
/// decided in place. `fileKey` null once the file is purged (decision 15).
model PaymentReceipt {
  id              String         @id @default(cuid(2))
  purpose         ReceiptPurpose
  signupId        String?
  clinicId        String?
  periodStart     DateTime?      @db.Date
  amountDue       Int
  reference       String         @db.VarChar(60)
  fileKey         String?        @db.VarChar(191)
  bytes           Int
  uploadedAt      DateTime
  status          ReceiptStatus
  decidedAt       DateTime?
  rejectionReason String?        @db.VarChar(500)

  @@index([status, uploadedAt])
  @@index([clinicId, uploadedAt])
  @@index([signupId, uploadedAt])
}
