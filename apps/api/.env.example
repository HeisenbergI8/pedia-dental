# Copy to .env. Matches docker-compose.yml.
DATABASE_URL=mysql://pedia:pedia@localhost:3307/pedia_dental
# Prisma's shadow database for `prisma migrate dev`, created by docker/mysql-init.sql.
SHADOW_DATABASE_URL=mysql://pedia:pedia@localhost:3307/pedia_dental_shadow
PORT=4100
# The web app's origin, allowed by CORS. Comma-separate several.
CORS_ORIGIN=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
