# Copy to .env. Matches docker-compose.yml.
DATABASE_URL=mysql://pedia:pedia@localhost:3307/pedia_dental
# Prisma's shadow database for `prisma migrate dev`, created by docker/mysql-init.sql.
SHADOW_DATABASE_URL=mysql://pedia:pedia@localhost:3307/pedia_dental_shadow
# The integration suite's database (`pnpm --filter api test:int`). Emptied by every test: must end in _test.
TEST_DATABASE_URL=mysql://pedia:pedia@localhost:3307/pedia_dental_test
PORT=4100
# The web app's origin, allowed by CORS. Comma-separate several.
CORS_ORIGIN=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# A demo deployment: lets `prisma db seed` run and serves the one-click demo logins. Never true with real clinics.
DEMO_LOGINS=true
# Secure cookies. false only for local http; leave it unset (true) everywhere else.
COOKIE_SECURE=false
# Run the scheduled jobs and the outbox worker in this process. false for a request-only instance.
BACKGROUND_WORK=true
# Milliseconds the outbox worker waits when there is nothing to send.
OUTBOX_POLL_MS=2000
# Where the local-disk storage driver keeps files (git-ignored).
STORAGE_DIR=var/storage
# B9: set to send real texts through Semaphore. Unset, texts are only logged (ids and part counts, never numbers or words).
# SEMAPHORE_API_KEY=
# The sender name every clinic's texts carry, once Semaphore has approved it. Unset: Semaphore's default.
# SMS_SENDER_NAME=
# SEMAPHORE_URL=https://api.semaphore.co/api/v4/messages
