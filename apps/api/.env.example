# Copy to .env. Matches docker-compose.yml.
DATABASE_URL=mysql://pedia:pedia@localhost:3307/pedia_dental
# Prisma's shadow database for `prisma migrate dev`, created by docker/mysql-init.sql.
SHADOW_DATABASE_URL=mysql://pedia:pedia@localhost:3307/pedia_dental_shadow
# The integration suite's database (`pnpm --filter api test:int`). Emptied by every test: must end in _test.
TEST_DATABASE_URL=mysql://pedia:pedia@localhost:3307/pedia_dental_test
PORT=4100
# B13a: local | demo | production. demo and production need https CORS_ORIGIN and WEB_URL, secure cookies and S3_BUCKET;
# production also refuses DEMO_LOGINS.
APP_ENV=local
# B13a: proxies in front of the API (1 behind the ALB). The rate limits read the client's address through them.
TRUST_PROXY_HOPS=0
# B13a: seconds between CloudWatch metrics lines on stdout (60 in a deployment). 0 = none.
METRICS_INTERVAL_S=0
# The web app's origins, allowed by CORS: exact scheme://host[:port], comma-separated, no path or trailing slash.
CORS_ORIGIN=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# A demo deployment: lets `prisma db seed` run and serves the one-click demo logins. Never true with real clinics.
DEMO_LOGINS=true
# DEMO_DAILY_RESET=false  (demo deployments only: wipes and reseeds at 03:40 Manila)
# Secure cookies. false only for local http; leave it unset (true) everywhere else.
COOKIE_SECURE=false
# Run the scheduled jobs and the outbox worker in this process. false for a request-only instance.
BACKGROUND_WORK=true
# Milliseconds the outbox worker waits when there is nothing to send.
OUTBOX_POLL_MS=2000
# Where the local-disk storage driver keeps files (git-ignored).
STORAGE_DIR=var/storage
# B10: Amazon S3 (production: ap-southeast-1) or an S3-compatible store. Unset S3_BUCKET = the local-disk driver above.
# S3_BUCKET=
# S3_REGION=ap-southeast-1
# R2 or MinIO only: their endpoint, and path-style addressing for MinIO.
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# Both or neither. Neither: the SDK's default credentials (an IAM role in production).
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Signs the local driver's 5-minute file links (32+ characters). Unset: a new random secret each start.
# STORAGE_LINK_SECRET=
# B9: set to send real texts through Semaphore. Unset, texts are only logged (ids and part counts, never numbers or words).
# SEMAPHORE_API_KEY=
# The sender name every clinic's texts carry, once Semaphore has approved it. Unset: Semaphore's default.
# SMS_SENDER_NAME=PRIMOLAR
# SEMAPHORE_URL=https://api.semaphore.co/api/v4/messages
# B11: the web app's address, which texted invite and reset links open (required in production).
# WEB_URL=http://localhost:3000
